{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "rangeStrategy": "bump",
    "separateMajorMinor": true,
    "separateMinorPatch": false,
    "packageRules": [
        {
            "groupName": "all minor and patch dependencies",
            "groupSlug": "all-minor-patch",
            "excludePackageNames": [
                "lucide-react"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "assigneesFromCodeOwners": true
        },
        {
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": null,
            "assigneesFromCodeOwners": true
        },
        {
            "matchPackageNames": [
                "lucide-react"
            ],
            "matchCurrentVersion": "^1\\.",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "platformAutomerge": true
        },
        {
            "description": "Stay on TypeScript 6.x; do not open PRs for 7.x",
            "matchPackageNames": [
                "typescript"
            ],
            "allowedVersions": "<7.0.0"
        },
        {
            "description": "Stay on ESLint 9.x; do not open PRs for 10.x",
            "matchPackageNames": [
                "eslint"
            ],
            "allowedVersions": "<10.0.0"
        }
    ]
}
